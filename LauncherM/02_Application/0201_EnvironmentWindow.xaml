<Window x:Class="LauncherM.EnvironmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LauncherM"
        mc:Ignorable="d"
        Title="EnvironmentWindow" Height="300" Width="300" Loaded="Window_Loaded" Closed="Window_Closed">
    <Grid>
        <StackPanel Orientation="Vertical">
            <StackPanel Orientation="Horizontal" Height="50"/>
            <StackPanel Orientation="Horizontal">
                <Label x:Name="labelQuantityLauncher" Content="□□□□□□"/>
                <RadioButton x:Name="rdbuttonQuantityLauncher01" Content="1" VerticalAlignment="Center"/>
                <RadioButton x:Name="rdbuttonQuantityLauncher02" Content="2" VerticalAlignment="Center"/>
                <RadioButton x:Name="rdbuttonQuantityLauncher03" Content="3" VerticalAlignment="Center"/>
                <RadioButton x:Name="rdbuttonQuantityLauncher04" Content="4" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
        
    </Grid>
</Window>
