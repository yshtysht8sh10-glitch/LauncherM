<Window x:Class="LauncherM.EnvironmentWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LauncherM 設定" Height="650" Width="500" MinHeight="520" MinWidth="480" WindowStartupLocation="CenterOwner" Background="#292929" Foreground="#F2F2F2" Loaded="WindowLoaded">
  <Window.Resources>
    <Style TargetType="TextBlock"><Setter Property="Margin" Value="0,0,0,6"/></Style>
    <Style TargetType="ComboBox"><Setter Property="Width" Value="400"/><Setter Property="HorizontalAlignment" Value="Left"/><Setter Property="Height" Value="32"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#F2F2F2"/></Style>
    <Style TargetType="Button"><Setter Property="Background" Value="#5B5B5B"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#888888"/><Setter Property="Padding" Value="14,6"/><Setter Property="Margin" Value="6,0,0,0"/></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,20,0">
      <TextBlock Text="外観" FontSize="26" FontWeight="Bold" Foreground="#65B5FF" Margin="0,0,0,20"/>
      <TextBlock Text="フォント" FontSize="15" FontWeight="Bold"/><ComboBox x:Name="fontFamilyBox" DisplayMemberPath="Source"/>
      <TextBlock Text="全体の文字サイズ" FontSize="15" FontWeight="Bold"/><ComboBox x:Name="fontSizeBox" DisplayMemberPath="Label"/>
      <TextBlock Text="テーマカラー" FontSize="15" FontWeight="Bold"/><ComboBox x:Name="themeBox"/>
      <Border Background="#343434" BorderBrush="#555555" BorderThickness="1" Padding="12" Margin="0,2,0,0"><StackPanel><TextBlock Text="プレビュー" Foreground="#AAAAAA"/><TextBlock x:Name="previewText" Text="LauncherM  いつもの作業環境を、ワンクリックで。" FontSize="16" TextWrapping="Wrap"/></StackPanel></Border>
      <Separator Margin="0,22,0,18"/>
      <TextBlock Text="起動ショートカット" FontSize="26" FontWeight="Bold" Foreground="#65B5FF" Margin="0,0,0,12"/>
      <CheckBox x:Name="hotkeyEnabledBox" Content="ショートカットキーでLauncherMを起動する" Margin="0,0,0,12" Checked="HotkeyEnabledChanged" Unchecked="HotkeyEnabledChanged"/>
      <StackPanel x:Name="hotkeyFields" Orientation="Horizontal">
        <StackPanel Width="210"><TextBlock Text="修飾キー" FontSize="15" FontWeight="Bold"/><ComboBox x:Name="hotkeyModifiersBox" Width="200"/></StackPanel>
        <TextBlock Text="＋" FontSize="20" VerticalAlignment="Center" Margin="10,0"/>
        <StackPanel Width="100"><TextBlock Text="キー" FontSize="15" FontWeight="Bold"/><ComboBox x:Name="hotkeyKeyBox" Width="100"/></StackPanel>
      </StackPanel>
      <TextBlock x:Name="hotkeyStatusText" Foreground="#AAAAAA" TextWrapping="Wrap" Margin="0,-8,0,0"/>
    </StackPanel></ScrollViewer>
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="適用" Click="ApplyClick"/><Button Content="OK" Width="72" IsDefault="True" Click="OkClick"/><Button Content="キャンセル" Width="90" IsCancel="True"/></StackPanel>
  </Grid>
</Window>
