<Window x:Class="LauncherM.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LauncherM Workspace" Width="1100" Height="700" Background="#292929" Foreground="#F2F2F2" PreviewKeyDown="WindowPreviewKeyDown">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#5B5B5B"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#A8A8A8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="154"/><Setter Property="Height" Value="142"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#3A3A3A"/><Setter Property="BorderBrush" Value="#505050"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#292929"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Background="#686868" Height="58" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="settingsButton" Content="⚙" FontSize="25" Width="54" Height="44" Click="OpenSettings" ToolTip="設定"/><Button x:Name="layoutBlock0" Content="" Background="#4B55FF" BorderBrush="White" Width="42" Height="38" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock1" Content="" Background="#3540E8" BorderBrush="White" Width="42" Height="38" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock2" Content="" Background="#202BD0" BorderBrush="White" Width="42" Height="38" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock3" Content="" Background="#3540E8" BorderBrush="White" Width="42" Height="38" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock4" Content="" Background="#202BD0" BorderBrush="White" Width="42" Height="38" Click="ToggleLayoutBlock"/><TextBlock Text="LauncherM" VerticalAlignment="Center" FontSize="17" FontWeight="Bold" Margin="4,0,10,0"/><TextBlock Text="Workspace :" VerticalAlignment="Center" Margin="0,0,5,0" FontSize="14"/><ComboBox x:Name="workspaceBox" Width="170" Height="32" DisplayMemberPath="Name" SelectionChanged="WorkspaceChanged"/><Button Content="▶ すべて起動" Click="LaunchAll" Margin="6,0,0,0" Background="#5B5B5B" FontWeight="Bold" Height="32" Width="125"/><Button Content="追加" Click="AddItem" Margin="3,0,0,0" Height="32" Width="58"/><Button Content="編集" Click="EditItem" Margin="3,0,0,0" Height="32" Width="58"/><Button Content="…" Margin="3,0,3,0" Height="32" Width="42"/>
    </StackPanel>
    <Grid Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="535"/><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border x:Name="itemsDropArea" Grid.Column="0" Background="#242424" Padding="14,22" AllowDrop="True" DragOver="ItemsDropAreaDragOver" Drop="ItemsDropAreaDrop"><ScrollViewer><WrapPanel x:Name="itemsPanel"/></ScrollViewer></Border><Border Grid.Column="1" Background="#AFAFAF"/><ScrollViewer Grid.Column="2"><StackPanel Margin="24,28"><StackPanel Orientation="Horizontal"><Image x:Name="detailIcon" Width="58" Height="58" Stretch="Uniform" Margin="0,0,20,0"/><StackPanel><TextBlock x:Name="detailName" Text="LaunchItemを選択" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="detailMemo" Text="" FontSize="16" Foreground="#BBBBBB"/></StackPanel></StackPanel><Separator Margin="0,22,0,22"/><StackPanel x:Name="detailFields" Visibility="Collapsed">
          <TextBlock Text="何を開く？ / Target" FontSize="18" Foreground="#65B5FF" FontWeight="Bold" Margin="0,0,0,8"/>
          <TextBlock Text="対象の種類"/><TextBox x:Name="typeText" IsReadOnly="True"/>
          <TextBlock Text="対象"/><TextBox x:Name="targetText" IsReadOnly="True" TextWrapping="Wrap"/>
          <Separator Margin="0,10"/>
          <TextBlock Text="何で開く？ / Opener" FontSize="18" Foreground="#65B5FF" FontWeight="Bold" Margin="0,0,0,8"/>
          <TextBlock Text="アプリ / 実行方法"/><TextBox x:Name="openerText" IsReadOnly="True"/>
          <StackPanel x:Name="profileDetails"><TextBlock Text="ブラウザプロファイル（Opener Context）"/><TextBox x:Name="profileText" IsReadOnly="True"/></StackPanel>
          <StackPanel x:Name="argumentDetails"><TextBlock Text="実行時の引数"/><TextBox x:Name="argumentsText" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel>
          <StackPanel x:Name="workingDirectoryDetails"><TextBlock Text="作業フォルダ（Opener Context）"/><TextBox x:Name="workingDirectoryText" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel>
          <Separator Margin="0,10"/>
          <TextBlock Text="どこに開く？ / Destination" FontSize="18" Foreground="#65B5FF" FontWeight="Bold" Margin="0,0,0,8"/>
          <TextBlock x:Name="destinationText" TextWrapping="Wrap"/>
          <StackPanel x:Name="groupDetails"><TextBlock Text="ウィンドウグループ（Destination Context）" Margin="0,8,0,0"/><TextBox x:Name="groupText" IsReadOnly="True"/></StackPanel>
        </StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,18"><Button Content="▶  起動" Click="LaunchSelected" Width="145" Height="46" FontSize="16"/><Button Content="■  フォルダを開く" Click="OpenSelectedFolder" Width="175" Height="46" FontSize="14"/><Button Content="編集" Click="EditItem" Width="120" Height="46" FontSize="14"/></StackPanel><Separator/><TextBlock Text="☷  Workspace 操作" FontSize="20" FontWeight="Bold" Margin="0,18,0,14"/><Button Content="▶  このWorkspaceをすべて起動" Click="LaunchAll" Height="52" FontSize="16"/></StackPanel></ScrollViewer></Grid>
  </DockPanel>
</Window>
