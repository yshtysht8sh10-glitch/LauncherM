<Window x:Class="LauncherM.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LauncherM" Width="900" Height="630" Background="#3A3A3A" Foreground="#EEEEEE">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#555555"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="154"/><Setter Property="Height" Value="142"/><Setter Property="FontSize" Value="15"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#EEEEEE"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Background="#126598" Height="86">
      <StackPanel Orientation="Horizontal" Height="42"><Button x:Name="settingsButton" Content="⚙" FontSize="22" Width="48" Click="OpenSettings" ToolTip="設定"/><Button x:Name="layoutBlock0" Content="■" Background="#3B0976" Width="30" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock1" Content="■" Background="#6E28C1" Width="30" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock2" Content="■" Background="#9A63DA" Width="30" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock3" Content="■" Background="#B189E0" Width="30" Click="ToggleLayoutBlock"/><TextBlock Text="  LauncherM" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="10,0"><TextBlock Text="Workspace :" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"/><ComboBox x:Name="workspaceBox" Width="270" Height="30" DisplayMemberPath="Name" SelectionChanged="WorkspaceChanged"/><Button Content="▶ すべて起動" Click="LaunchAll" Margin="14,0,0,0" Background="#245A7A" FontWeight="Bold" Height="30"/><Button Content="追加" Click="AddItem" Margin="6,0,0,0" Height="30"/><Button Content="編集" Click="EditItem" Margin="3,0,0,0" Height="30"/><Button Content="…" Margin="3,0,0,0" Height="30" Width="42"/></StackPanel>
    </StackPanel>
    <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#2C2C2C" Padding="10"><ScrollViewer><WrapPanel x:Name="itemsPanel"/></ScrollViewer></Border><Border Grid.Column="1" Background="#126598"/><ScrollViewer Grid.Column="2"><StackPanel Margin="20,12"><StackPanel Orientation="Horizontal"><TextBlock x:Name="detailIcon" Text="◆" FontSize="46" Foreground="#168DD0" VerticalAlignment="Center" Margin="0,0,18,0"/><StackPanel><TextBlock x:Name="detailName" Text="LaunchItemを選択" FontSize="25" FontWeight="Bold"/><TextBlock x:Name="detailMemo" Text="" FontSize="15" Foreground="#BBBBBB"/></StackPanel></StackPanel><Separator Margin="0,18,0,18"/><TextBlock Text="種類" FontSize="15"/><TextBox x:Name="typeText" IsReadOnly="True"/><TextBlock Text="実行ファイル / Target" FontSize="15"/><TextBox x:Name="targetText" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="引数" FontSize="15"/><TextBox x:Name="argumentsText" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="作業フォルダ" FontSize="15"/><TextBox x:Name="workingDirectoryText" IsReadOnly="True" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,8,0,15"><Button Content="▶  起動" Click="LaunchSelected" Width="120" Height="40" FontSize="15"/><Button Content="■  フォルダを開く" Click="OpenSelectedFolder" Height="40" FontSize="14"/><Button Content="編集" Click="EditItem" Height="40" FontSize="14"/></StackPanel><Separator/><TextBlock Text="☷  Workspace 操作" FontSize="19" FontWeight="Bold" Margin="0,16,0,12"/><Button Content="▶  このWorkspaceをすべて起動" Click="LaunchAll" Height="48" FontSize="15"/></StackPanel></ScrollViewer></Grid>
  </DockPanel>
</Window>
