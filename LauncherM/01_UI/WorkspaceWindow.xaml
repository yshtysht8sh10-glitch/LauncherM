<Window x:Class="LauncherM.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LauncherM Workspace" Width="1100" Height="700" Background="#292929" Foreground="#F2F2F2">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#5B5B5B"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#A8A8A8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="154"/><Setter Property="Height" Value="142"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#3A3A3A"/><Setter Property="BorderBrush" Value="#505050"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#292929"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
  </Window.Resources>
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Background="#686868" Height="92">
      <StackPanel Orientation="Horizontal" Height="48"><Button x:Name="settingsButton" Content="⚙" FontSize="28" Width="62" Height="42" Click="OpenSettings" ToolTip="設定"/><Button x:Name="layoutBlock0" Content="" Background="#4B55FF" BorderBrush="White" Width="54" Height="38" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock1" Content="" Background="#3540E8" BorderBrush="White" Width="54" Height="38" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock2" Content="" Background="#202BD0" BorderBrush="White" Width="54" Height="38" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock3" Content="" Background="#3540E8" BorderBrush="White" Width="54" Height="38" Click="ToggleLayoutBlock"/><Button x:Name="layoutBlock4" Content="" Background="#202BD0" BorderBrush="White" Width="54" Height="38" Click="ToggleLayoutBlock"/><TextBlock Text="  LauncherM" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/></StackPanel>
      <StackPanel Orientation="Horizontal" Margin="10,0"><TextBlock Text="Workspace :" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="16"/><ComboBox x:Name="workspaceBox" Width="290" Height="32" DisplayMemberPath="Name" SelectionChanged="WorkspaceChanged"/><Button Content="▶ すべて起動" Click="LaunchAll" Margin="14,0,0,0" Background="#5B5B5B" FontWeight="Bold" Height="32" Width="150"/><Button Content="追加" Click="AddItem" Margin="6,0,0,0" Height="32" Width="82"/><Button Content="編集" Click="EditItem" Margin="3,0,0,0" Height="32" Width="82"/><Button Content="…" Margin="3,0,0,0" Height="32" Width="60"/></StackPanel>
    </StackPanel>
    <Grid Margin="0"><Grid.ColumnDefinitions><ColumnDefinition Width="535"/><ColumnDefinition Width="3"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#242424" Padding="14,22"><ScrollViewer><WrapPanel x:Name="itemsPanel"/></ScrollViewer></Border><Border Grid.Column="1" Background="#AFAFAF"/><ScrollViewer Grid.Column="2"><StackPanel Margin="24,28"><StackPanel Orientation="Horizontal"><TextBlock x:Name="detailIcon" Text="◆" FontSize="58" Foreground="#168DD0" VerticalAlignment="Center" Margin="0,0,20,0"/><StackPanel><TextBlock x:Name="detailName" Text="LaunchItemを選択" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="detailMemo" Text="" FontSize="16" Foreground="#BBBBBB"/></StackPanel></StackPanel><Separator Margin="0,22,0,22"/><TextBlock Text="種類" FontSize="16"/><TextBox x:Name="typeText" IsReadOnly="True"/><TextBlock Text="実行ファイル / Target" FontSize="16"/><TextBox x:Name="targetText" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="引数" FontSize="16"/><TextBox x:Name="argumentsText" IsReadOnly="True" TextWrapping="Wrap"/><TextBlock Text="作業フォルダ" FontSize="16"/><TextBox x:Name="workingDirectoryText" IsReadOnly="True" TextWrapping="Wrap"/><StackPanel Orientation="Horizontal" Margin="0,10,0,18"><Button Content="▶  起動" Click="LaunchSelected" Width="145" Height="46" FontSize="16"/><Button Content="■  フォルダを開く" Click="OpenSelectedFolder" Width="175" Height="46" FontSize="14"/><Button Content="編集" Click="EditItem" Width="120" Height="46" FontSize="14"/></StackPanel><Separator/><TextBlock Text="☷  Workspace 操作" FontSize="20" FontWeight="Bold" Margin="0,18,0,14"/><Button Content="▶  このWorkspaceをすべて起動" Click="LaunchAll" Height="52" FontSize="16"/></StackPanel></ScrollViewer></Grid>
  </DockPanel>
</Window>
