<Window x:Class="LauncherM.WorkspaceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LauncherM Workspace" Width="1180" Height="720" MinWidth="880" MinHeight="520" Background="#292929" Foreground="#F2F2F2" PreviewKeyDown="WindowPreviewKeyDown" PreviewMouseDown="WindowPreviewMouseDown" Closing="WindowClosing">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Background" Value="#5B5B5B"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#A8A8A8"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="8,4"/></Style>
    <Style x:Key="TileStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="154"/><Setter Property="Height" Value="142"/><Setter Property="FontSize" Value="15"/><Setter Property="Background" Value="#3A3A3A"/><Setter Property="BorderBrush" Value="#505050"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style x:Key="WorkspaceTabStyle" TargetType="ToggleButton"><Setter Property="Background" Value="#3A3A3A"/><Setter Property="Foreground" Value="#E8E8E8"/><Setter Property="BorderBrush" Value="#606060"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,7"/><Setter Property="Margin" Value="0,0,3,0"/><Setter Property="Cursor" Value="SizeAll"/><Setter Property="ToolTip" Value="ドラッグして並び替え"/><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Background" Value="#174E78"/><Setter Property="BorderBrush" Value="#65B5FF"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#292929"/><Setter Property="Foreground" Value="#F2F2F2"/><Setter Property="BorderBrush" Value="#777777"/><Setter Property="Margin" Value="0,2,0,8"/></Style>
  </Window.Resources>
  <DockPanel>
    <ScrollViewer DockPanel.Dock="Top" Height="58" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Background="#686868"><StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="settingsButton" Content="⚙" FontSize="25" Width="54" Height="44" Click="OpenSettings" ToolTip="設定"/><TextBlock Text="LauncherM" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="8,0,10,0"/><Button x:Name="displayModeButton" Content="☷ 全Workspace表示" Height="36" Click="ToggleDisplayMode" ToolTip="現在のWorkspace表示と全Workspace表示を切り替え"/><ComboBox x:Name="workspaceBox" Visibility="Collapsed" DisplayMemberPath="Name" SelectionChanged="WorkspaceChanged"/>
    </StackPanel></ScrollViewer>
    <Border DockPanel.Dock="Top" Background="#202020" BorderBrush="#4A4A4A" BorderThickness="0,0,0,1" Padding="8,6"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="workspaceTabs" Orientation="Horizontal" AllowDrop="True" DragOver="WorkspaceTabsDragOver" Drop="WorkspaceTabsDrop"/></ScrollViewer></Border>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="workspaceColumn" Width="220" MinWidth="160"/><ColumnDefinition x:Name="workspaceSplitterColumn" Width="5"/><ColumnDefinition x:Name="itemsColumn" Width="*" MinWidth="200"/><ColumnDefinition Width="5"/><ColumnDefinition x:Name="detailsColumn" Width="390" MinWidth="300"/></Grid.ColumnDefinitions>
      <Border x:Name="workspacePane" Grid.Column="0" Background="#303030" Padding="14,18"><StackPanel><TextBlock Text="☷  Workspace 操作" FontSize="20" FontWeight="Bold"/><Grid Margin="0,12,0,18"><TextBlock x:Name="workspaceNameText" FontSize="24" TextWrapping="Wrap" Foreground="#65B5FF" Cursor="IBeam" ToolTip="クリックしてWorkspace名を編集" MouseLeftButtonDown="BeginInlineWorkspaceRename"/><TextBox x:Name="workspaceNameEditor" Visibility="Collapsed" FontSize="24" Foreground="#65B5FF" Background="#303030" BorderBrush="#65B5FF" BorderThickness="1" Margin="0" Padding="2,0" KeyDown="InlineWorkspaceNameKeyDown" LostKeyboardFocus="InlineWorkspaceNameLostFocus"/></Grid><Button Content="▶  このWorkspaceをすべて起動" Click="LaunchAll" Height="50" FontSize="14"/><Button Content="■  このWorkspaceをすべて閉じる" Click="CloseWorkspace" Height="50" FontSize="14" Background="#594343"/><Separator Margin="0,15"/><Button Content="Workspaceを削除" Click="DeleteWorkspace" Height="38"/></StackPanel></Border>
      <GridSplitter x:Name="workspaceSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#777777" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <Border x:Name="itemsDropArea" Grid.Column="2" Background="#242424" Padding="14,12" AllowDrop="True" DragOver="ItemsDropAreaDragOver" Drop="ItemsDropAreaDrop" PreviewMouseWheel="ItemsAreaMouseWheel"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel x:Name="itemsToolbar" Orientation="Horizontal" Margin="0,0,0,8"><Button Content="＋ リンクを追加" Click="AddLink" Height="34" ToolTip="URLを直接入力してリンクカードを追加"/><TextBlock Text="ドラッグで並び替え・ホイールでカードサイズ変更" VerticalAlignment="Center" Foreground="#A8A8A8" Margin="8,0,0,0"/></StackPanel><ScrollViewer x:Name="itemsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><Grid Width="{Binding ViewportWidth, ElementName=itemsScrollViewer}"><WrapPanel x:Name="itemsPanel" AllowDrop="True" DragOver="ItemsPanelDragOver" Drop="ItemsPanelDrop"/><StackPanel x:Name="allWorkspacesPanel" Visibility="Collapsed"/></Grid></ScrollViewer></Grid></Border>
      <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#777777" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>
      <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><StackPanel Margin="24,28"><StackPanel Orientation="Horizontal"><Image x:Name="detailIcon" Width="58" Height="58" Stretch="Uniform" Margin="0,0,20,0"/><StackPanel><TextBlock x:Name="detailName" Text="LaunchItemを選択" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="detailMemo" FontSize="16" Foreground="#BBBBBB"/></StackPanel></StackPanel><Separator Margin="0,22"/><StackPanel x:Name="detailFields" Visibility="Collapsed">
        <TextBlock Text="何を開く？ / Target" FontSize="18" Foreground="#65B5FF" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="対象の種類"/><TextBox x:Name="typeText" IsReadOnly="True"/><TextBlock Text="対象"/><TextBox x:Name="targetText" IsReadOnly="True" TextWrapping="Wrap"/><Separator Margin="0,10"/>
        <TextBlock Text="何で開く？ / Opener" FontSize="18" Foreground="#65B5FF" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock Text="アプリ / 実行方法"/><TextBox x:Name="openerText" IsReadOnly="True"/><StackPanel x:Name="profileDetails"><TextBlock Text="ブラウザプロファイル（Opener Context）"/><TextBox x:Name="profileText" IsReadOnly="True"/></StackPanel><StackPanel x:Name="argumentDetails"><TextBlock Text="実行時の引数"/><TextBox x:Name="argumentsText" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel><StackPanel x:Name="workingDirectoryDetails"><TextBlock Text="作業フォルダ（Opener Context）"/><TextBox x:Name="workingDirectoryText" IsReadOnly="True" TextWrapping="Wrap"/></StackPanel><Separator Margin="0,10"/>
        <TextBlock Text="どこに開く？ / Destination" FontSize="18" Foreground="#65B5FF" FontWeight="Bold" Margin="0,0,0,8"/><TextBlock x:Name="destinationText" TextWrapping="Wrap"/><StackPanel x:Name="groupDetails"><TextBlock Text="ウィンドウグループ（Destination Context）" Margin="0,8,0,0"/><TextBox x:Name="groupText" IsReadOnly="True"/></StackPanel>
      </StackPanel><StackPanel Orientation="Horizontal" Margin="0,10,0,18"><Button Content="▶  起動" Click="LaunchSelected" Width="120" Height="46" FontSize="16"/><Button Content="■  フォルダを開く" Click="OpenSelectedFolder" Width="155" Height="46" FontSize="14"/><Button Content="編集" Click="EditItem" Width="90" Height="46" FontSize="14"/></StackPanel></StackPanel></ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
